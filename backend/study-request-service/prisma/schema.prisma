generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudentRequest {
  id          Int        @id @default(autoincrement())
  asker_id    Int
  helper_id   Int?       // Nullable
  topic       String        @db.VarChar(255)
  description String        @db.VarChar(255)
  mode        RequestMode
  status      RequestStatus @default(open)
  campus      campusField?
  created_at  DateTime      @db.Timestamptz(0)
  updated_at  DateTime      @db.Timestamptz(0) @updatedAt

  meetup      SessionMeetup?
  messages    SessionMessage[]

  @@map("students-request")
}

enum RequestMode {
  online
  insite
}
enum campusField {
  Rabat
  Tetouan
  Benguerir
  Khouribga
}
enum RequestStatus {
  open
  claimed
  completed
  cancelled
}

model SessionMeetup {
  id             Int   @id @default(autoincrement())
  
  // The Foreign Key and 1-to-1 Unique constraint
  request_id     Int   @unique
  request        StudentRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  
  plan_spot      String   @db.VarChar(100)
  asker_on_way   Boolean  @default(false)
  asker_arrived  Boolean  @default(false)
  helper_on_way  Boolean  @default(false)
  helper_arrived Boolean  @default(false)
  
  created_at     DateTime @default(now()) @db.Timestamptz
  
  // Maps this Prisma model strictly to your lowercase SQL table name
  @@map("sessions_meetup")
}


model SessionMessage {
  id         Int   @id @default(autoincrement())
  
  // Standard Foreign Key (No @unique constraint means 1-to-Many)
  request_id Int
  request    StudentRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  
  sender_id  Int
  text       String   @db.VarChar(500)
  created_at DateTime @default(now()) @db.Timestamptz

  // Maps this Prisma model strictly to your lowercase SQL table name
  @@map("session_messages")
}