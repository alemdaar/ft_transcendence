DATABASE_URL=postgresql://postgres:postgres@localhost:5432/transcendence
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET=replace-with-a-different-random-secret-at-least-32-characters
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password
FORTYTWO_CLIENT_ID=your-42-client-id
FORTYTWO_CLIENT_SECRET=your-42-client-secret
# Route the callback through the same browser host as the frontend so its cookie is available.
FORTYTWO_REDIRECT_URI=http://localhost:5173/auth/42/callback
FRONTEND_URL=http://localhost:5173/
PORT=3001
NODE_ENV=development
# Leave empty for direct connections; set exact trusted proxy addresses for deployment.
TRUST_PROXY=
